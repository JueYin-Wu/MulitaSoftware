# Copiar este archivo como "secrets.properties" (en la misma carpeta) y completar con los datos reales.
# secrets.properties está en .gitignore: NUNCA se sube a GitHub. Este archivo de ejemplo sí se sube,
# así que acá NO va el token real.

# Access Token de Mercado Pago (Tus integraciones > tu aplicación > Credenciales de prueba).
app.mercadopago.access-token=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
app.mercadopago.public-key=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
